# Optional: without these keys, explicitly labeled local demo coaching is used.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
# Browser-native SpeechRecognition and speechSynthesis provide ASR and TTS.
# Some browsers send recognition audio to their vendor; text mode is always available.
