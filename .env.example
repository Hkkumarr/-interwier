# DEFAULT: working demo, no credentials needed.
# Setup copies this file to .env.local without overwriting existing settings.
# Keep keys server-side. Never commit .env.local or use NEXT_PUBLIC_ for secrets.

# AI: demo | openai. OpenAI enables JD analysis, questions, and answer feedback.
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Research: disabled | tavily. Shows actual source URLs/titles/excerpts/dates.
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=

# Restart npm run dev after changes. Check configuration with npm run doctor.
# Voice uses browser SpeechRecognition (ASR) and speechSynthesis (TTS).
# Some browsers send audio to their vendor. This app never stores raw audio.
